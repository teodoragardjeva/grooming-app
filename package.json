{
  "name": "magic-paws-grooming",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:node && vitest run",
    "test:node": "node --experimental-strip-types --no-warnings --test tests/unit/*.test.ts",
    "test:db": "docker compose -f docker-compose.test.yml --profile run run --rm dbtests",
    "test:e2e": "playwright test",
    "test:integration": "docker compose -f docker-compose.test.yml up -d --wait testdb && vitest run --config vitest.integration.config.mts",
    "test:db:down": "docker compose -f docker-compose.test.yml --profile run down -v",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cormorant": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@hookform/resolvers": "^7.0.3",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
