# Copy to .env (docker compose reads it) and fill in. Never commit the real file.

# --- Database (PostgreSQL container from docker-compose.yml) ---
POSTGRES_DB=grooming
POSTGRES_USER=grooming
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Set to 1 once on a fresh database to load EXAMPLE services/hours (db/seed.sql). Leave 0 in production.
SEED_EXAMPLE_DATA=0

# --- App ---
# Public URL of the site (used for e-mail links, sitemap, hreflang). Inlined at build time.
NEXT_PUBLIC_SITE_URL=http://localhost
# Domain Caddy serves with automatic HTTPS (e.g. example.com). ":80" = plain HTTP for local use.
SITE_ADDRESS=:80
# Random strings, at least 32 characters (e.g. `openssl rand -hex 32`).
# Changing TOKEN_HASH_SECRET invalidates outstanding e-mail links.
TOKEN_HASH_SECRET=
CRON_SECRET=

# --- E-mail (Resend) ---
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. Магически Лапички <no-reply@your-domain>
RESEND_FROM=

# --- Optional: Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Local development without Docker for the app (npm run dev) ---
# DATABASE_URL=postgres://grooming:change-me@localhost:5432/grooming
# MEDIA_DIR=./data/media
