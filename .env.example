# Copy to .env.local. Never commit real values.

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (browser-safe values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (SERVER ONLY - never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL for integration tests (local/test database only)
TEST_DATABASE_URL=

# Resend (SERVER ONLY). RESEND_API_KEY is added automatically by the Vercel Marketplace
# integration; locally use `vercel env pull .env.local`. RESEND_FROM is ours to set.
RESEND_API_KEY=
RESEND_FROM="Магически Лапички <no-reply@example.com>"

# Secrets for hashing tokens and protecting cron endpoint (generate long random strings)
TOKEN_HASH_SECRET=
CRON_SECRET=

# Optional bot protection (e.g. Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
